{
	"name": "@marky/desktop",
	"private": true,
	"version": "0.1.0",
	"description": "Marky desktop app",
	"license": "MIT",
	"author": "Warp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/warpdotdev-demos/warp-learn-markdown-app.git",
		"directory": "apps/desktop"
	},
	"bugs": "https://github.com/warpdotdev-demos/warp-learn-markdown-app/issues",
	"type": "module",
	"main": "./out/main/main.js",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:debug": "MARKY_DESKTOP_ENABLE_CDP=1 node scripts/dev.mjs",
		"build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && electron-vite build",
		"bundle:mac": "pnpm build && electron-builder --mac",
		"bundle:win": "pnpm build && electron-builder --win nsis --x64",
		"bundle:win:arm64": "pnpm build && electron-builder --win nsis --arm64",
		"bundle:linux": "pnpm build && electron-builder --linux",
		"bundle:linux:arm64": "pnpm build && electron-builder --linux --arm64",
		"preview": "vite preview",
		"sync:playground": "node scripts/sync-playground.mjs",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"@floating-ui/dom": "^1.7.5",
		"@marky/editor": "workspace:*",
		"@marky/error-reporter": "workspace:*",
		"@marky/runtime": "workspace:*",
		"@marky/ui": "workspace:*",
		"@simplestack/store": "^0.7.5",
		"@tailwindcss/browser": "^4.3.1",
		"@tiptap/core": "^3.4.3",
		"@tiptap/extension-image": "^3.4.2",
		"@tiptap/extension-list": "^3.4.2",
		"@tiptap/pm": "^3.3.0",
		"@tiptap/react": "^3.3.0",
		"@tiptap/starter-kit": "^3.3.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"alpinejs": "^3.15.12",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"ignore": "^7.0.5",
		"keymatch": "^1.0.5",
		"node-pty": "^1.1.0",
		"open-props": "^1.7.23",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@iconify-json/mingcute": "^1.2.7",
		"@playwright/test": "^1.63.0",
		"@svgr/core": "^8.1.0",
		"@svgr/plugin-jsx": "^8.1.0",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^25.5.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"chokidar": "^4.0.3",
		"electron": "^42.3.1",
		"electron-builder": "^26.16.1",
		"electron-vite": "^5.0.0",
		"shadcn": "^4.1.0",
		"tailwindcss": "^4.1.18",
		"typescript": "~5.8.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^7.0.4",
		"vitest": "^3.2.4"
	},
	"build": {
		"appId": "dev.warp.marky",
		"productName": "Marky",
		"directories": {
			"output": "release"
		},
		"files": [
			"out/**"
		],
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"category": "public.app-category.productivity"
		},
		"win": {
			"target": [
				"nsis"
			]
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"artifactName": "marky_${version}_${arch}.${ext}"
		},
		"linux": {
			"executableName": "marky",
			"category": "Office",
			"target": [
				"AppImage",
				"deb",
				"rpm"
			]
		},
		"appImage": {
			"artifactName": "marky_${version}_${arch}.${ext}"
		},
		"deb": {
			"packageName": "marky",
			"artifactName": "marky_${version}_${arch}.${ext}"
		},
		"rpm": {
			"packageName": "marky",
			"artifactName": "marky_${version}_${arch}.${ext}"
		},
		"fileAssociations": [
			{
				"name": "Markdown Document",
				"description": "Markdown text file",
				"ext": "md",
				"role": "Editor",
				"rank": "Owner"
			},
			{
				"name": "Markdown Document",
				"description": "Markdown text file",
				"ext": "markdown",
				"role": "Editor",
				"rank": "Owner"
			},
			{
				"name": "Markdown Document",
				"description": "Markdown text file",
				"ext": "mdown",
				"role": "Editor",
				"rank": "Owner"
			}
		]
	}
}
